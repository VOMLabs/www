# PostgreSQL connection string used by Drizzle ORM and the database client.
# Example: postgresql://user:password@host:5432/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/website-database"

# Base URL of the application used by Better Auth for redirects and cookies.
# Example: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Secret used to sign Better Auth sessions. Use a long random string.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-long-random-secret"

# Garage S3 — used for profile picture uploads.
# Endpoint should include the port (e.g. https://host:port)
S3_ENDPOINT="http://website-garage-8079b1-5-175-245-175.sslip.io"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="avatars"
# Public URL used to serve uploaded images (no trailing slash).
S3_PUBLIC_URL="http://website-garage-8079b1-5-175-245-175.sslip.io/avatars"
