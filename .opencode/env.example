# Environment Variables for .opencode plugins
# Copy this file to .env and fill in your actual values.

# Gemini API Configuration
# Used by the custom image tools in .opencode/plugins/gemini
# (gemini_generate_image / gemini_edit_image / gemini_analyze_image).
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: run the gemini image tools without calling the API (returns mock output)
# GEMINI_TEST_MODE=true